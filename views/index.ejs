<%- include('partials/header') %>


<form method="post" action="/links" class="create">
  <input name="url" placeholder="https://..." required>
  <button>Raccourcir</button>
</form>

<% if (error) { %><p class="error"><%= error %></p><% } %>

<form method="get" action="/">
  <p>Trier par :</p>
  <input type="hidden" name="sort" value="clicks">
  <button name="order" value="desc" <%= sort === "clicks" && order === "desc" ? "disabled" : "" %>>Plus cliqués</button>
  <button name="order" value="asc"  <%= sort === "clicks" && order === "asc"  ? "disabled" : "" %>>Moins cliqués</button>
  <a href="/">Ordre d'origine</a>
</form>


<table>
  <tr><th>Lien court</th><th>Adresse</th><th>Clics</th><th></th></tr>
  <% links.forEach((link) => { %>
    <tr>
      <td><a href="/<%= link.code %>">/<%= link.code %></a></td>
      <td class="url"><%= link.url %></td>
      <td><%= link.clicks %></td>
      <td>
        <form method="post" action="/links/<%= link.code %>/delete">
          <button class="danger">Supprimer</button>
        </form>
      </td>
    </tr>
  <% }) %>
</table>
<p><%= links.length %> liens</p>

<%- include('partials/footer') %>
