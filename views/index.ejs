<%- include('partials/header') %>


<form method="post" action="/links" class="create">
  <input name="url" placeholder="https://..." required>
  <button>Raccourcir</button>
</form>

<% if (error) { %><p class="error"><%= error %></p><% } %>

<p>Trier par :</p>
<form method="get" action="/" class="sort">
  <button name="sort" value="clicks">Plus cliqués</button>
  <a href="/">Plus récents</a>
</form>


<table>
  <tr><th>Lien court</th><th>Adresse</th><th>Clics</th><th>Expire le</th><th></th></tr>
  <% links.forEach((link) => { %>
    <tr>
      <td><a href="/<%= link.code %>">/<%= link.code %></a></td>
      <td class="url"><%= link.url %></td>
      <td><%= link.clicks %></td>
      <td>
        <% if (!link.expiresAt) { %>
          Jamais
        <% } else if (link.expiresAt < new Date()) { %>
          Expiré
        <% } else { %>
          <%= link.expiresAt.toLocaleDateString('fr-FR') %>
        <% } %>
      </td>
      <td>
        <form method="post" action="/links/<%= link.code %>/delete">
          <button class="danger">Supprimer</button>
        </form>
      </td>
    </tr>
  <% }) %>
</table>
<p><%= links.length %> liens</p>

<%- include('partials/footer') %>
